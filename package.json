{
  "name": "live-tv-hub",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Free-to-air live TV from around the world, built with shadcn/ui and the iptv-org catalog.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build-seo.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "data:sync": "tsx scripts/build-data.ts",
    "test": "tsx scripts/test-country.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
